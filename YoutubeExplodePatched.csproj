<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<IsPackable>true</IsPackable>

		<PackageId>YoutubeExplode.PatchedByMizuura</PackageId>
		<Version>1.6.6.1</Version>
		<Authors>Mizuura</Authors>
		<Company>Mizuurka</Company>
		<Product>Mizuurka.YoutubeExplode</Product>
		<Description>Clean, telemetry-free fork of YoutubeExplode, optimized for .NET 10 applications.</Description>
		<Copyright>Copyright © Mizuura 2026</Copyright>
	</PropertyGroup>

	<PropertyGroup>
		<PackageIcon>favicon.png</PackageIcon>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>


	<ItemGroup>
		<PackageReference Include="AngleSharp" Version="1.3.1" Internalize="true" PrivateAssets="all" />
		<PackageReference Include="Binternal" Version="1.0.0" PrivateAssets="all" />
		<PackageReference Include="CSharpier.MsBuild" Version="0.29.2" PrivateAssets="all" />
		<PackageReference Include="JsonExtensions" Version="1.2.3" Internalize="true" PrivateAssets="all" />
		<PackageReference Include="Lazy.Fody" Version="1.11.0" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.2" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'netstandard2.1'))" />
		<PackageReference Include="PolyShim" Version="2.11.0" PrivateAssets="all" />
		<PackageReference Include="PowerKit" Version="1.0.0" Internalize="true" PrivateAssets="all" />
		<PackageReference Include="Snek" Version="1.0.0" PrivateAssets="all" />
		<PackageReference Include="System.Text.Json" Version="9.0.2" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'netcoreapp3.0'))" />
		<PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.0" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'netstandard2.1'))" />
	</ItemGroup>

	<ItemGroup>
		<None Include="favicon.png" Pack="true" PackagePath="" />
		<Resource Include="favicon.png" />
	</ItemGroup>

</Project>